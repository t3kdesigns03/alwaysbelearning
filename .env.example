# ── Public (safe in the browser) ────────────────────────────────
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Server only (Netlify env vars; never in client code) ───────
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ANTHROPIC_API_KEY=sk-ant-...

# AI provider: anthropic | gemini (unset → whichever key is present, Anthropic first)
ABL_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-ai-studio-key

# Optional model overrides
# ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_GRADER_MODEL=claude-haiku-4-5
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_GRADER_MODEL=gemini-2.5-flash-lite

# Used only by `npm run seed` (one time, from your own machine)
# DAD_EMAIL=you@example.com
# DAD_PASSWORD=choose-a-long-one
